{
  "name": "clirace",
  "version": "0.1.0",
  "private": true,
  "description": "Fast, competitive Linux and DevOps CLI training.",
  "workspaces": [
    "apps/*"
  ],
  "scripts": {
    "build": "pnpm --filter @clirace/api build && pnpm --filter @clirace/web build",
    "dev": "concurrently -n api,web -c cyan,magenta \"pnpm --filter @clirace/api dev\" \"pnpm --filter @clirace/web dev\"",
    "dev:api": "pnpm --filter @clirace/api dev",
    "dev:web": "pnpm --filter @clirace/web dev",
    "typecheck": "pnpm --filter @clirace/api typecheck && pnpm --filter @clirace/web typecheck",
    "test:battle-e2e": "node scripts/test-battle-e2e.mjs",
    "test:shell-e2e": "node scripts/test-shell-e2e.mjs",
    "test:sandbox-platform": "pnpm --filter @clirace/api exec tsx ../../scripts/test-sandbox-platform.mts",
    "test:checker-framework": "pnpm --filter @clirace/api exec tsx ../../scripts/test-checker-framework.mts",
    "test:shell-completion": "pnpm --filter @clirace/api exec tsx ../../scripts/test-shell-completion.mts",
    "test:checker-production": "node scripts/test-checker-production.mjs",
    "test:terminal-replay": "pnpm --filter @clirace/api exec tsx ../../scripts/test-terminal-replay.mts",
    "test:terminal-replay-production": "node scripts/test-terminal-replay-production.mjs",
    "test:terminal-startup-banner": "pnpm --filter @clirace/api exec tsx ../../scripts/test-terminal-startup-banner.mts",
    "test:real-shell-integrity": "node scripts/test-real-shell-integrity.mjs",
    "test:interview-100": "node scripts/test-interview-100.mjs",
    "test:production-smoke": "node scripts/test-production-smoke.mjs",
    "test:matchmaking": "pnpm --filter @clirace/api test:matchmaking",
    "test:matchmaking-e2e": "node scripts/test-matchmaking-e2e.mjs",
    "linux-core:validate": "pnpm --filter @clirace/api linux-core:validate",
    "linux-core:import": "pnpm --filter @clirace/api linux-core:import",
    "learning-paths:validate": "pnpm --filter @clirace/api learning-paths:validate",
    "learning-paths:import": "pnpm --filter @clirace/api learning-paths:import",
    "test:learning-paths": "pnpm --filter @clirace/api test:learning-paths",
    "test:learning": "pnpm --filter @clirace/api test:learning",
    "test:learning-production": "node scripts/test-learning-e2e.mjs",
    "test:learning-paths-production": "node scripts/test-learning-paths-production.mjs",
    "test:ranked": "pnpm --filter @clirace/api test:ranked",
    "test:ranked-matchmaking": "pnpm --filter @clirace/api test:ranked-matchmaking",
    "test:ranked-service": "pnpm --filter @clirace/api test:ranked-e2e",
    "test:ranked-e2e": "node scripts/test-ranked-e2e.mjs",
    "test:production-polish": "pnpm --filter @clirace/api exec tsx ../../scripts/test-production-polish.mts",
    "test:pvp-practice-flow": "pnpm --filter @clirace/api exec tsx ../../scripts/test-pvp-practice-flow.mts",
    "start": "pnpm --filter @clirace/api start"
  },
  "engines": {
    "node": ">=22.0.0",
    "pnpm": ">=10.0.0"
  },
  "packageManager": "pnpm@11.16.0",
  "devDependencies": {
    "concurrently": "^9.2.1",
    "typescript": "^5.9.2",
    "ws": "^8.21.3"
  }
}
