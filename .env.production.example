# Public hostname without scheme or path.
PUBLIC_HOST=clirace.example
PUBLIC_SCHEME=https
ACME_EMAIL=admin@clirace.example

# Optional: set this when automatic public-IP discovery is unavailable.
# PUBLIC_IP=203.0.113.10

APP_PORT=8080
LOG_LEVEL=info
HTTP_BODY_LIMIT_BYTES=65536

POSTGRES_DB=clirace
POSTGRES_USER=clirace
POSTGRES_PASSWORD=CHANGE_ME_LONG_RANDOM_DATABASE_PASSWORD
REDIS_PASSWORD=CHANGE_ME_DIFFERENT_LONG_RANDOM_REDIS_PASSWORD

AUTH_COOKIE_NAME=clirace_session
AUTH_SESSION_TTL_SECONDS=604800
AUTH_COOKIE_SECURE=true

# Always detected by deployment from the live rootless socket. Do not persist a
# numeric SANDBOX_SOCKET_GID: rootless subordinate IDs can change after restart.
# SANDBOX_DOCKER_SOCKET_HOST=/run/user/1001/docker.sock
SANDBOX_IMAGE=clirace-sandbox:0.2.0
SANDBOX_MEMORY_MB=256
SANDBOX_CPUS=0.25
SANDBOX_PIDS=64
SANDBOX_MAX_SESSIONS=25
SANDBOX_MAX_SESSIONS_PER_USER=1
SANDBOX_WARM_POOL_SIZE=0
SANDBOX_MAX_LIFETIME_SECONDS=900
SANDBOX_IDLE_TIMEOUT_SECONDS=180

BATTLE_COUNTDOWN_MS=3000
BATTLE_RECONNECT_GRACE_SECONDS=60
BATTLE_WAITING_TTL_SECONDS=1800
BATTLE_MAX_LIFETIME_SECONDS=1800

# Quick Match: один публичный FIFO-pool в Redis.
MATCHMAKING_ENABLED=true
MATCHMAKING_LEASE_SECONDS=90
MATCHMAKING_PAIRING_TTL_SECONDS=120
MATCHMAKING_MATCH_TTL_SECONDS=3600
MATCHMAKING_BATTLE_WAITING_TTL_SECONDS=120
