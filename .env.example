# Copy to .env before running Docker Compose.
NODE_ENV=production
APP_PORT=80
LOG_LEVEL=info
HTTP_BODY_LIMIT_BYTES=65536

POSTGRES_DB=clirace
POSTGRES_USER=clirace
POSTGRES_PASSWORD=change-me-before-production

REDIS_PASSWORD=change-me-before-production

AUTH_COOKIE_NAME=clirace_session
AUTH_SESSION_TTL_SECONDS=604800
AUTH_COOKIE_SECURE=false

# Quick Match: одна Redis-очередь и короткие восстанавливаемые lease-состояния.
MATCHMAKING_ENABLED=true
MATCHMAKING_LEASE_SECONDS=90
MATCHMAKING_PAIRING_TTL_SECONDS=120
MATCHMAKING_MATCH_TTL_SECONDS=3600
MATCHMAKING_BATTLE_WAITING_TTL_SECONDS=120
