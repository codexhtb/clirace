# The sandbox prototype is intentionally reachable only through an SSH tunnel.
APP_PORT=8080
LOG_LEVEL=info

POSTGRES_DB=clirace
POSTGRES_USER=clirace
POSTGRES_PASSWORD=replace-with-a-long-url-safe-password
REDIS_PASSWORD=replace-with-a-different-long-url-safe-password

AUTH_COOKIE_NAME=clirace_session
AUTH_SESSION_TTL_SECONDS=604800

SANDBOX_DOCKER_SOCKET_HOST=/run/user/1001/docker.sock
SANDBOX_SOCKET_GID=1001
SANDBOX_IMAGE=clirace-sandbox:0.2.0
SANDBOX_MEMORY_MB=256
SANDBOX_CPUS=0.25
SANDBOX_PIDS=64
SANDBOX_MAX_SESSIONS=4
SANDBOX_MAX_LIFETIME_SECONDS=900
SANDBOX_IDLE_TIMEOUT_SECONDS=180
