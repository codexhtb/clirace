# The gateway remains loopback-only; public traffic is terminated by host Caddy.
APP_PORT=8080
LOG_LEVEL=info
HTTP_BODY_LIMIT_BYTES=65536

POSTGRES_DB=clirace
POSTGRES_USER=clirace
POSTGRES_PASSWORD=replace-with-a-long-url-safe-password
REDIS_PASSWORD=replace-with-a-different-long-url-safe-password

AUTH_COOKIE_NAME=clirace_session
AUTH_SESSION_TTL_SECONDS=604800
AUTH_COOKIE_SECURE=false

SANDBOX_DOCKER_SOCKET_HOST=/run/user/1001/docker.sock
# SANDBOX_SOCKET_GID is detected at deployment from the live socket.
SANDBOX_IMAGE=clirace-sandbox:0.2.0
SANDBOX_MEMORY_MB=256
SANDBOX_CPUS=0.25
SANDBOX_PIDS=64
SANDBOX_MAX_SESSIONS=25
SANDBOX_MAX_SESSIONS_PER_USER=1
SANDBOX_WARM_POOL_SIZE=0
SANDBOX_MAX_LIFETIME_SECONDS=900
SANDBOX_IDLE_TIMEOUT_SECONDS=180

# Quick Match использует существующие Battle и Sandbox Platform.
MATCHMAKING_ENABLED=true
MATCHMAKING_LEASE_SECONDS=90
MATCHMAKING_PAIRING_TTL_SECONDS=120
MATCHMAKING_MATCH_TTL_SECONDS=3600
MATCHMAKING_BATTLE_WAITING_TTL_SECONDS=120
