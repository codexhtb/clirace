  "items": [
    {
      "id": "operator-process-port-troubleshooting-port-evidence-lesson",
      "slug": "port-evidence",
      "title": "Начните с socket evidence",
      "type": "theory",
      "order": 1,
      "category": "networking",
      "concept": "port_evidence",
      "version": 1,
      "content": [
        {
          "type": "heading",
          "text": "Начните с socket evidence"
        },
        {
          "type": "paragraph",
          "text": "Ошибка address already in use означает конфликт bind. Сначала найдите точный listener через `ss`, не останавливайте случайные процессы."
        },
        {
          "type": "code",
          "language": "bash",
          "code": "ss -lntp 'sport = :8080'"
        },
        {
          "type": "bullets",
          "items": [
            "Цель: Найдите listener TCP/8080.",
            "Проверка: Socket evidence связывает symptom с конкретным owner."
          ]
        },
        {
          "type": "note",
          "tone": "warning",
          "text": "Socket evidence связывает symptom с конкретным owner."
        }
      ],
      "completion": {
        "explicitContinue": true
      }
    },
    {
