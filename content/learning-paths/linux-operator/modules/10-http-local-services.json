  "items": [
    {
      "id": "operator-http-local-services-request-response-lesson",
      "slug": "request-response",
      "title": "HTTP request и response",
      "type": "theory",
      "order": 1,
      "category": "networking",
      "concept": "http_exchange",
      "version": 1,
      "content": [
        {
          "type": "heading",
          "text": "HTTP request и response"
        },
        {
          "type": "paragraph",
          "text": "HTTP работает поверх transport connection: client отправляет method, path и headers, server возвращает status, headers и body."
        },
        {
          "type": "code",
          "language": "bash",
          "code": "curl -i http://127.0.0.1:8081/status.txt"
        },
        {
          "type": "bullets",
          "items": [
            "Цель: Получите локальный status endpoint с headers.",
            "Проверка: HTTP success не доказывает внешний reachability или корректность всего приложения."
          ]
        },
        {
          "type": "note",
          "tone": "warning",
          "text": "HTTP success не доказывает внешний reachability или корректность всего приложения."
        }
      ],
      "completion": {
        "explicitContinue": true
      }
    },
    {
      "id": "operator-http-local-services-request-response-quiz",
