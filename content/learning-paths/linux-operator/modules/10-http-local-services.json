    {
      "id": "operator-http-local-services-verbose-lesson",
      "slug": "verbose",
      "title": "`curl -v` разделяет transport и HTTP",
      "type": "theory",
      "order": 5,
      "category": "networking",
      "concept": "http_diagnostics",
      "version": 1,
      "content": [
        {
          "type": "heading",
          "text": "`curl -v` разделяет transport и HTTP"
        },
        {
          "type": "paragraph",
          "text": "Verbose output показывает resolution, connect, request и response. Это помогает отличить connection refused от HTTP 404 или 500."
        },
        {
          "type": "code",
          "language": "bash",
          "code": "curl -v http://127.0.0.1:8081/status.txt"
        },
        {
          "type": "bullets",
          "items": [
            "Цель: Выполните подробный локальный probe.",
            "Проверка: Transport failure происходит до получения HTTP status."
          ]
        },
        {
          "type": "note",
          "tone": "warning",
          "text": "Transport failure происходит до получения HTTP status."
        }
      ],
      "completion": {
        "explicitContinue": true
      }
    },
    {
      "id": "operator-http-local-services-verbose-quiz",
