    {
      "id": "operator-system-inspection-uptime-load-lesson",
      "slug": "uptime-load",
      "title": "Uptime и load без паники",
      "type": "theory",
      "order": 3,
      "category": "processes",
      "concept": "system_load",
      "version": 1,
      "content": [
        {
          "type": "heading",
          "text": "Uptime и load без паники"
        },
        {
          "type": "paragraph",
          "text": "Load average показывает число выполняемых и ожидающих CPU или непрерываемый I/O задач за интервалы 1, 5 и 15 минут. Его сравнивают с числом CPU и другими evidence."
        },
        {
          "type": "code",
          "language": "bash",
          "code": "uptime"
        },
        {
          "type": "bullets",
          "items": [
            "Цель: Покажите uptime и load average.",
            "Проверка: Одно число load без CPU count и временной динамики не доказывает проблему."
          ]
        },
        {
          "type": "note",
          "tone": "note",
          "text": "Одно число load без CPU count и временной динамики не доказывает проблему."
        }
      ],
      "completion": {
        "explicitContinue": true
      }
    },
