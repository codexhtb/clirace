  "items": [
    {
      "id": "operator-logs-incidents-scope-tail-lesson",
      "slug": "scope-tail",
      "title": "Начните с узкого временного окна",
      "type": "theory",
      "order": 1,
      "category": "logs",
      "concept": "log_scope",
      "version": 1,
      "content": [
        {
          "type": "heading",
          "text": "Начните с узкого временного окна"
        },
        {
          "type": "paragraph",
          "text": "Не читайте весь log сверху. Сначала выберите нужный файл, последние строки и момент симптома через `tail`, timestamps и request ID."
        },
        {
          "type": "code",
          "language": "bash",
          "code": "tail -n 50 /workspace/logs/app.log"
        },
        {
          "type": "bullets",
          "items": [
            "Цель: Покажите последние 50 строк application log.",
            "Проверка: Узкое окно снижает шум до появления первой гипотезы."
          ]
        },
        {
          "type": "note",
          "tone": "note",
          "text": "Узкое окно снижает шум до появления первой гипотезы."
        }
      ],
      "completion": {
        "explicitContinue": true
      }
    },
    {
