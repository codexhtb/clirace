    {
      "id": "operator-logs-incidents-evidence-report-lesson",
      "slug": "evidence-report",
      "title": "Evidence и incident summary",
      "type": "theory",
      "order": 7,
      "category": "logs",
      "concept": "incident_summary",
      "version": 1,
      "content": [
        {
          "type": "heading",
          "text": "Evidence и incident summary"
        },
        {
          "type": "paragraph",
          "text": "Хороший summary содержит scope, наблюдаемый symptom, ключевые records и проверяемый вывод. Не переписывайте весь log и не меняйте source fixtures."
        },
        {
          "type": "code",
          "language": "bash",
          "code": "grep -n \"ERROR\" /workspace/logs/app.log > /workspace/error-evidence.txt"
        },
        {
          "type": "bullets",
          "items": [
            "Цель: Сохраните строки ERROR в отдельный evidence file.",
            "Проверка: Отдельный artifact можно проверить, передать и повторно построить."
          ]
        },
        {
          "type": "note",
          "tone": "warning",
          "text": "Отдельный artifact можно проверить, передать и повторно построить."
        }
      ],
      "completion": {
        "explicitContinue": true
      }
    },
